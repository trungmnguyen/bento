          "target_field": "stdout",
          "description": "Ground-truth contract: math.factorial(6) == 720"
        },
        {
          "type": "MAX_DURATION_MS",
          "expected": 1000,
          "target_field": "duration_ms",
          "description": "Execution completed under 1000ms latency ceiling"
        }
      ]
    }
  ]
}